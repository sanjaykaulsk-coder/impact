{
  "name": "impact-field-command",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"pnpm --filter backend dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter backend build && pnpm --filter web build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "prisma:migrate": "pnpm --filter backend prisma:migrate",
    "prisma:seed": "pnpm --filter backend prisma:seed",
    "qa:grep": "bash scripts/qa-grep.sh"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}

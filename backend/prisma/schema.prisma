// No binaries in the database (spec §35) — only object-storage keys and metadata.
model Media {
  id                      String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String                  @db.Uuid
  campaignId              String                  @db.Uuid
  activityInstanceId      String?                 @db.Uuid
  activityInstance        ActivityInstance?       @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
  formResponseId          String?                 @db.Uuid
  formResponse            FormResponse?           @relation(fields: [formResponseId], references: [id], onDelete: SetNull)
  fieldResponseId         String?                 @db.Uuid
  fieldResponse           FieldResponse?          @relation(fields: [fieldResponseId], references: [id], onDelete: SetNull)
  uploadedByUserId        String                  @db.Uuid
  deviceId                String?                 @db.Uuid
  objectKeyOriginal       String
  objectKeyWatermarked    String?
  mimeType                String
  sizeBytes               Int
  sha256Hash              String
  // Perceptual duplicate detection (spec §17/§18, docs/architecture/08 §5: "exact-hash duplicates
  // in MVP; perceptual similarity post-MVP") — a 64-bit difference-hash (dHash), nullable because
  // media rows created before this feature have none. sha256Hash alone only catches byte-identical
  // re-uploads; this catches a re-compressed, cropped, or re-photographed copy of the same scene.
  perceptualHash          String?
  latitude                Decimal?                @db.Decimal(9, 6)
  longitude               Decimal?                @db.Decimal(9, 6)
  capturedAt              DateTime?
  variant                 MediaVariant            @default(ORIGINAL)
  validationStatus        MediaValidationStatus   @default(PENDING)
  approvalStatus          ApprovalStatus          @default(PENDING)
  downloadPermissionLevel DownloadPermissionLevel @default(WATERMARKED_ONLY)
  uploadStatus            SyncStatus              @default(PENDING_UPLOAD)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([campaignId])
  @@index([clientId])
  @@index([sha256Hash])
  @@map("media")
}

enum MediaUploadSessionStatus {
  UPLOADING
  COMPLETED
  ABANDONED
}

// Transient session tracking a chunked, resumable photo upload in progress (doc 05's "Chunked,
// resumable media" strategy: /media/init -> chunks -> /complete). Deliberately separate from
// Media — Media represents a finished, validated artifact; this represents the in-progress state
// a client can legitimately reconnect to and resume after a dropped connection, without ever
// re-uploading bytes the server already has. Chunk bytes themselves live on local disk under a
// temp directory keyed by this session's id, not in Postgres or MinIO — reassembled into the
// final object only once `complete` verifies every chunk arrived and the whole-file hash matches.
model MediaUploadSession {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String                   @db.Uuid
  campaignId         String                   @db.Uuid
  activityInstanceId String                   @db.Uuid
  activityInstance   ActivityInstance         @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  uploadedByUserId   String                   @db.Uuid
  deviceId           String?                  @db.Uuid
  sha256Hash         String
  sizeBytes          Int
  mimeType           String
  chunkSize          Int                      @default(524288)
  totalChunks        Int
  receivedChunks     Int[]                    @default([])
  latitude           Decimal                  @db.Decimal(9, 6)
  longitude          Decimal                  @db.Decimal(9, 6)
  capturedAt         DateTime
  status             MediaUploadSessionStatus @default(UPLOADING)
  resultMediaId      String?                  @db.Uuid
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // One resumable session per distinct file per activity per uploader — re-calling /init with the
  // same hash (the normal case: a client resuming after a dropped connection) finds and returns
  // this same session rather than starting a second one for content the server already has part of.
  @@unique([activityInstanceId, uploadedByUserId, sha256Hash])
  @@index([clientId])
  @@map("media_upload_sessions")
}


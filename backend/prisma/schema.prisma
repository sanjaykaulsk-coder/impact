  stockReportId        String      @db.Uuid
  stockReport          StockReport @relation(fields: [stockReportId], references: [id], onDelete: Cascade)
  skuName              String
  openingStock         Decimal     @db.Decimal(12, 2)
  stockReceived        Decimal     @db.Decimal(12, 2)
  unitsSold            Decimal     @db.Decimal(12, 2)
  unitsSampled         Decimal     @db.Decimal(12, 2)
  unitsDamaged         Decimal     @db.Decimal(12, 2)
  expectedClosingStock Decimal     @db.Decimal(12, 2)
  actualClosingStock   Decimal?    @db.Decimal(12, 2)
  mismatchFlag         Boolean     @default(false)
  createdAt            DateTime    @default(now())

  @@index([stockReportId])
  @@map("stock_items")
}

model SalesReport {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String           @db.Uuid
  activityInstanceId String           @db.Uuid
  activityInstance   ActivityInstance @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  campaignId         String           @db.Uuid
  submittedByUserId  String           @db.Uuid
  totalValue         Decimal          @default(0) @db.Decimal(14, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items SalesItem[]

  @@index([clientId])
  @@index([campaignId])
  @@map("sales_reports")
}

model SalesItem {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  salesReportId String      @db.Uuid
  salesReport   SalesReport @relation(fields: [salesReportId], references: [id], onDelete: Cascade)
  skuName       String
  quantity      Decimal     @db.Decimal(12, 2)
  unitPrice     Decimal     @db.Decimal(12, 2)
  totalValue    Decimal     @db.Decimal(14, 2)
  createdAt     DateTime    @default(now())

  @@index([salesReportId])
  @@map("sales_items")
}

model Lead {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String            @db.Uuid
  activityInstanceId String?           @db.Uuid
  activityInstance   ActivityInstance? @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
  campaignId         String            @db.Uuid
  name               String
  phone              String?
  notes              String?
  status             LeadStatus        @default(NEW)
  createdAt          DateTime          @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@map("leads")
}

model Retailer {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String     @db.Uuid
  campaignId  String     @db.Uuid
  name        String
  shopName    String?
  phone       String?
  address     String?
  geographyId String?    @db.Uuid
  geography   Geography? @relation(fields: [geographyId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([clientId])
  @@index([campaignId])
  @@map("retailers")
}

model Consumer {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String            @db.Uuid
  activityInstanceId String?           @db.Uuid
  activityInstance   ActivityInstance? @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
  campaignId         String            @db.Uuid
  name               String?
  phone              String?
  notes              String?
  createdAt          DateTime          @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@map("consumers")
}

// ============================================================================
// GOVERNANCE
// ============================================================================

model Approval {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String             @db.Uuid
  entityType        ApprovalEntityType
  entityId          String             @db.Uuid
  campaignId        String             @db.Uuid
  requestedByUserId String             @db.Uuid
  approverUserId    String?            @db.Uuid
  status            ApprovalStatus     @default(PENDING)
  remarks           String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([clientId])
  @@index([campaignId])
  @@index([entityType, entityId])
  @@map("approvals")
}

// Activity continues while approval is pending (spec §14) — never a blocking gate on the device.
model DeviationRequest {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String           @db.Uuid
  activityInstanceId String           @db.Uuid
  activityInstance   ActivityInstance @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  campaignId         String           @db.Uuid
  userId             String           @db.Uuid
  deviationType      DeviationType
  distanceMeters     Decimal?         @db.Decimal(10, 2)
  reason             String
  remarks            String?
  status             ApprovalStatus   @default(PENDING)
  decidedByUserId    String?          @db.Uuid
  decidedAt          DateTime?
  // Manual escalation only this stage (no delayed-job/queue infra exists yet to promote this on a
  // timer per spec §29's 0/15/30/60-minute ladder) — see docs/ASSUMPTIONS.md A-059.
  escalationLevel    Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([clientId])
  @@index([campaignId])
  @@map("deviation_requests")
}

model Exception {
  id                      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                String            @db.Uuid
  campaignId              String            @db.Uuid
  category                String
  severity                ExceptionSeverity @default(MEDIUM)
  triggerType             String
  activityInstanceId      String?           @db.Uuid
  activityInstance        ActivityInstance? @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
  userId                  String?           @db.Uuid
  locationId              String?           @db.Uuid
  ownerUserId             String?           @db.Uuid
  escalationLevel         Int               @default(0)
  status                  ExceptionStatus   @default(DETECTED)
  evidenceJson            Json?
  remarks                 String?
  resolution              String?
  resolvedAt              DateTime?
  closureApprovedByUserId String?           @db.Uuid
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  escalations Escalation[]

  @@index([clientId])
  @@index([campaignId])
  @@map("exceptions")
}

model Alert {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId            String            @db.Uuid
  clientId              String            @db.Uuid
  activityInstanceId    String?           @db.Uuid
  activityInstance      ActivityInstance? @relation(fields: [activityInstanceId], references: [id], onDelete: SetNull)
  userId                String?           @db.Uuid
  locationId            String?           @db.Uuid
  issueType             String
  severity              ExceptionSeverity @default(MEDIUM)
  timestamp             DateTime          @default(now())
  ownerUserId           String?           @db.Uuid
  status                AlertStatus       @default(OPEN)
  remarks               String?
  evidenceJson          Json?
  resolutionDeadline    DateTime?
  escalationLevel       Int               @default(0)
  closureApproverUserId String?           @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  escalations Escalation[]

  @@index([campaignId])
  @@index([clientId])
  @@map("alerts")
}

// Escalation ladder: Activity Supervisor → Activity Spoke → Regional Ops → Operations Director,
// with configurable time thresholds (spec §29). Exactly one of alertId/exceptionId is set.
model Escalation {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  alertId        String?    @db.Uuid
  alert          Alert?     @relation(fields: [alertId], references: [id], onDelete: Cascade)
  exceptionId    String?    @db.Uuid
  exception      Exception? @relation(fields: [exceptionId], references: [id], onDelete: Cascade)
  fromRoleId     String?    @db.Uuid
  toRoleId       String     @db.Uuid
  level          Int
  triggeredAt    DateTime   @default(now())
  acknowledgedAt DateTime?
  createdAt      DateTime   @default(now())

  @@map("escalations")
}

model Comment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @db.Uuid
  entityType   String
  entityId     String   @db.Uuid
  campaignId   String   @db.Uuid
  authorUserId String   @db.Uuid
  body         String
  createdAt    DateTime @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@index([entityType, entityId])
  @@map("comments")
}

// Append-only, immutable to ordinary administrators (spec §37, CLAUDE.md). Application code never
// updates or deletes a row here; a Postgres migration additionally REVOKEs UPDATE/DELETE on this
// table from the application role as a second, DB-enforced guarantee.
model AuditLog {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String?       @db.Uuid
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  clientId       String?       @db.Uuid
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  campaignId     String?       @db.Uuid
  campaign       Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  actorUserId    String?       @db.Uuid
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String?       @db.Uuid
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  createdAt      DateTime      @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Report {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId          String       @db.Uuid
  campaignId        String       @db.Uuid
  type              ReportType
  format            ReportFormat
  generatedByUserId String?      @db.Uuid
  objectKey         String?
  periodStart       DateTime?
  periodEnd         DateTime?
  createdAt         DateTime     @default(now())

  @@index([clientId])
  @@index([campaignId])
  @@map("reports")
}

model DownloadPermission {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String?              @db.Uuid
  role         Role?                @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId       String?              @db.Uuid
  resourceType DownloadResourceType
  campaignId   String?              @db.Uuid
  clientId     String?              @db.Uuid
  granted      Boolean              @default(true)
  createdAt    DateTime             @default(now())

  @@map("download_permissions")
}

model Notification {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String              @db.Uuid
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  title             String
  body              String
  status            NotificationStatus  @default(PENDING)
  relatedEntityType String?
  relatedEntityId   String?             @db.Uuid
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([userId])
  @@map("notifications")
}

// Spec §31 "WhatsApp video verification (v1 approach)": a supervisor-initiated call logged for
// audit, never the call content itself — "never store WhatsApp call recordings or private call
// data" is honored by design, since this table only ever holds metadata the supervisor types in.
model WhatsAppVerification {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String           @db.Uuid
  campaignId         String           @db.Uuid
  activityInstanceId String           @db.Uuid
  activityInstance   ActivityInstance @relation(fields: [activityInstanceId], references: [id], onDelete: Cascade)
  initiatedByUserId  String           @db.Uuid
  verificationType   String
  startedAt          DateTime         @default(now())
  completedAt        DateTime?
  outcome            String?
  remarks            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([clientId])
  @@index([campaignId])
  @@map("whatsapp_verifications")
}

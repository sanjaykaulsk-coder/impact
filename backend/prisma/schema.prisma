// IMPACT FIELD COMMAND — Prisma schema
// Entity groups follow docs/FIELD_COMMAND_SPEC.md §34 exactly: Organisation & Access, Campaign,
// Forms, Workflow, Execution, Governance. A handful of infra-only tables (OtpChallenge) are added
// where the spec's entity list assumes infrastructure that isn't itself a product entity — each is
// marked "(infra, not in spec §34)".
//
// Conventions (CLAUDE.md, locked):
//   - UUIDs everywhere (Postgres native uuid, generated by pgcrypto's gen_random_uuid())
//   - tenant_id (clientId) + campaignId on every relevant table, usually denormalized onto
//     execution/governance rows even when reachable via a join, so the tenant guard, the Prisma
//     tenant-scoping extension and the Postgres RLS policies all filter on one column name.
//   - Row-Level Security is enabled in a follow-up migration (see prisma/migrations/*_enable_rls)
//     for every table with a clientId column, fail-closed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Language {
  EN
  HI
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum DeviceStatus {
  ACTIVE
  PENDING_APPROVAL
  BLOCKED
}

enum RiskLevel {
  L1_WARNING
  L2_FLAGGED
  L3_RESTRICTED
  L4_BLOCKED
}

enum CampaignAccessStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ClientStatus {
  ACTIVE
  INACTIVE
}

enum CampaignStatus {
  DRAFT
  CONFIGURATION_IN_PROGRESS
  READY_FOR_REVIEW
  APPROVED
  PUBLISHED
  LIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GeographyLevel {
  STATE
  REGION
  DISTRICT
  TEHSIL
}

enum LocationStatus {
  ACTIVE
  CANCELLED
}

enum PjpStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PjpRowStatus {
  ACTIVE
  CANCELLED
  POSTPONED
  RESCHEDULED
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TargetScopeType {
  CAMPAIGN
  GEOGRAPHY
  TEAM
  USER
}

enum FormVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// The spec's field-type list, §10.
enum FieldType {
  SHORT_TEXT
  LONG_TEXT
  INTEGER
  DECIMAL
  CURRENCY
  PERCENTAGE
  DATE
  TIME
  DATETIME
  DROPDOWN
  RADIO
  MULTI_SELECT
  CHECKBOX
  YES_NO
  RATING
  PHOTO
  MULTIPLE_PHOTOS
  SHORT_VIDEO
  SIGNATURE
  DOCUMENT
  GPS
  AUTO_TIMESTAMP
  AUTO_USER
  AUTO_ACTIVITY_ID
  AUTO_CAMPAIGN_ID
  AUTO_LOCATION
  AUTO_CALCULATED
  SKU_SELECTOR
  QUANTITY
  MEASUREMENT
  SALES_VALUE
  STOCK_VALUE
  RETAILER_DETAILS
  CONSUMER_DETAILS
  REMARKS
  APPROVAL_STATUS
}

enum ConditionalAction {
  SHOW
  HIDE
  REQUIRE
  OPTIONAL
}

// The four report-format archetypes every one of the 21 real campaign types expresses its field
// data through (report-format-library §1). Stored on FormTemplate when a form is created from a
// preset, so mid-campaign SKU changes can regenerate exactly the SKU-bound sections.
enum FormArchetype {
  DFR
  PROFILE
  STOCK_RECONCILIATION
  ENQUIRY_LEADS
}

// The validated movement-type list from the source workbook's real sheets (report-format-library
// §3, build-sequence S3.1). Each movement row carries quantity and (where the sheet has an Amt./
// Value column) amount — so "Sc. Card Qty." + "Sc. Card Value" are one FREE_SCHEME row, not two.
enum SkuMovementType {
  OPENING_STOCK
  RECEIVED
  SOLD
  FREE_SCHEME
  SAMPLED
  DAMAGED
  CLOSING_STOCK_ACTUAL
}

// Pre-activity SOP checklist item status (spec §12). The readiness view's five statuses
// (Completed/Pending/Delayed/At risk/Not applicable) are a rollup computed from these per-item
// marks plus timing, not a sixth stored state — see ReadinessService.
enum SopItemStatus {
  PENDING
  COMPLETED
  NOT_APPLICABLE
}

// The spec's sync status model, §19.
enum SyncStatus {
  DRAFT
  SAVED_OFFLINE
  PENDING_UPLOAD
  UPLOADING
  PARTIALLY_UPLOADED
  SYNCED
  UPLOAD_FAILED
  VALIDATION_FAILED
  USER_ACTION_REQUIRED
}

enum ActivityInstanceStatus {
  PLANNED
  DISPATCHED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AttendanceType {
  DAY_START
  DAY_END
}

enum MediaVariant {
  ORIGINAL
  WATERMARKED
}

enum MediaValidationStatus {
  PENDING
  VALID
  DUPLICATE_SUSPECTED
  SCREENSHOT_RISK
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DownloadPermissionLevel {
  WATERMARKED_ONLY
  ORIGINAL_ALLOWED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

enum ApprovalEntityType {
  ACTIVITY_INSTANCE
  FORM_RESPONSE
  RECCE
}

// Deviation types, spec §14.
enum DeviationType {
  OUTSIDE_PERMITTED_RADIUS
  UNPLANNED_LOCATION
  SKIPPED_LOCATION
  WRONG_SEQUENCE
  LATE_ARRIVAL
  EARLY_DEPARTURE
  UNPLANNED_STOPPAGE
  GPS_DISABLED
  ABNORMAL_SPEED
  SUSPECTED_LOCATION_MANIPULATION
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Exception ticket lifecycle, spec §30.
enum ExceptionStatus {
  DETECTED
  ASSIGNED
  ACKNOWLEDGED
  UNDER_REVIEW
  ACTION_TAKEN
  RESOLVED
  CLOSURE_APPROVED
  REOPENED
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  ESCALATED
  RESOLVED
}

enum ReportType {
  DAILY
  WEEKLY
  CAMPAIGN_CLOSURE
}

enum ReportFormat {
  EXCEL
  DASHBOARD
  WHATSAPP_SUMMARY
}

enum DownloadResourceType {
  ORIGINAL_MEDIA
  RAW_DATA
  REPORT_EXCEL
}

enum NotificationChannel {
  IN_APP
  PUSH
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

// ============================================================================
// ORGANISATION & ACCESS
// ============================================================================

model Organisation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clients   Client[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organisations")
}

model Client {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String       @db.Uuid
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  name                String
  code                String       @unique
  logoUrl             String?
  brandColorPrimary   String?
  brandColorSecondary String?
  status              ClientStatus @default(ACTIVE)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  campaigns         Campaign[]
  auditLogs         AuditLog[]
  userCampaignRoles UserCampaignRole[]

  @@map("clients")
}

model User {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId    String       @db.Uuid
  organisation      Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  fullName          String
  email             String?
  preferredLanguage Language     @default(EN)
  status            UserStatus   @default(ACTIVE)
  lastLoginAt       DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  mobileCredential MobileCredential?
  devices          Device[]
  loginSessions    LoginSession[]
  campaignRoles    UserCampaignRole[]
  auditLogsAsActor AuditLog[]         @relation("AuditActor")
  notifications    Notification[]

  @@map("users")
}

// Login is by mobile number + OTP (spec §7). One credential per user; the mobile number is the
// login identifier, never a real production phone number in seed data (spec §41).
model MobileCredential {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  countryCode  String   @default("+91")
  mobileNumber String
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([countryCode, mobileNumber])
  @@map("mobile_credentials")
}

// A short-lived OTP challenge. (infra, not in spec §34 — required to implement §7's OTP flow.)
// The mock provider (see backend/src/modules/auth/otp) never sends a real SMS: it logs the plain
// code to the console and returns it in the API response in non-production environments only.
model OtpChallenge {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryCode  String    @default("+91")
  mobileNumber String
  codeHash     String
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([countryCode, mobileNumber])
  @@map("otp_challenges")
}

// Configurable RBAC (spec §8): roles and permissions are data, never hard-coded role-name checks.
model Role {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId String       @db.Uuid
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  name           String
  code           String       @unique
  category       String
  description    String?
  isSystem       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  rolePermissions     RolePermission[]
  userCampaignRoles   UserCampaignRole[]
  stageAssignments    StageAssignment[]
  stageApprovalRules  StageApprovalRule[]
  downloadPermissions DownloadPermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// The core "a person may hold different roles in different campaigns" table (spec §7).
model UserCampaignRole {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String               @db.Uuid
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId         String               @db.Uuid
  campaign           Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId           String               @db.Uuid
  client             Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  roleId             String               @db.Uuid
  role               Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  reportingManagerId String?              @db.Uuid
  reportingManager   UserCampaignRole?    @relation("ReportingLine", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reports            UserCampaignRole[]   @relation("ReportingLine")
  teamId             String?              @db.Uuid
  team               Team?                @relation(fields: [teamId], references: [id], onDelete: SetNull)
  geographyScopeJson Json?
  status             CampaignAccessStatus @default(ACTIVE)
  accessExpiresAt    DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([userId, campaignId, roleId])
  @@index([campaignId])
  @@index([clientId])
  @@map("user_campaign_roles")
}

model Device {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @db.Uuid
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceFingerprint String
  deviceModel       String?
  osVersion         String?
  appVersion        String?
  status            DeviceStatus @default(PENDING_APPROVAL)
  riskLevel         RiskLevel    @default(L1_WARNING)
  isRooted          Boolean      @default(false)
  firstSeenAt       DateTime     @default(now())
  lastSeenAt        DateTime     @default(now())

  loginSessions LoginSession[]
  gpsPoints     GPSPoint[]

  @@unique([userId, deviceFingerprint])
  @@map("devices")
}

// Rotating refresh tokens (spec §7). Each active session stores only the hash of the current
// refresh token; issuing a new one revokes the old row's usability (see auth/token.service.ts).
model LoginSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId         String    @db.Uuid
  device           Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?

  @@index([userId])
  @@index([deviceId])
  @@map("login_sessions")
}

// ============================================================================
// CAMPAIGN
// ============================================================================

model Campaign {
  id                       String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId                 String         @db.Uuid
  client                   Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name                     String
  code                     String         @unique
  activityTypeId           String?        @db.Uuid
  activityType             ActivityType?  @relation(fields: [activityTypeId], references: [id], onDelete: SetNull)
  status                   CampaignStatus @default(DRAFT)
  reportingLanguage        Language       @default(EN)
  startDate                DateTime
  endDate                  DateTime?
  deviationToleranceMeters Int            @default(250)
  mediaRequirementsJson    Json?
  // Per-signal risk-level overrides (spec §18: "configurable risk levels"), e.g.
  // {"DEVICE_TIME_MISMATCH": "L2_FLAGGED"} — signals not listed here fall back to
  // DeviceRiskService's own defaults. Never hard-coded per client, same posture as every other
  // *Json campaign config field.
  deviceRiskRulesJson      Json?
  offlineMapRequired       Boolean        @default(false)
  clientVisibilityJson     Json?
  downloadRightsJson       Json?
  dataRetentionDays        Int?
  publishedSnapshotVersion Int            @default(0)
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  branding           CampaignBranding?
  campaignActivities CampaignActivity[]
  pjps               PJP[]
  routes             Route[]
  teams              Team[]
  userAssignments    UserAssignment[]
  targets            Target[]
  userCampaignRoles  UserCampaignRole[]
  formTemplates      FormTemplate[]
  workflows          Workflow[]
  auditLogs          AuditLog[]
  campaignSkus       CampaignSku[]
  dashboardWidgets   DashboardWidgetConfig[]

  @@index([clientId])
  @@map("campaigns")
}

// Campaign SKU Master (report-format-library §3): every campaign that reports sales/stock gets a
// per-campaign configurable SKU list — never hard-coded per client. The workbook's per-SKU column
// groups become rows here; forms bind questions to a CampaignSku via controlsJson.
model CampaignSku {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String   @db.Uuid
  campaignId   String   @db.Uuid
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  skuCode      String
  name         String
  variantLabel String?
  category     String?
  mrp          Decimal? @db.Decimal(12, 2)
  sellingPrice Decimal? @db.Decimal(12, 2)
  packSize     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements SkuMovement[]

  @@unique([campaignId, skuCode])
  @@index([clientId])
  @@index([campaignId])
  @@map("campaign_skus")
}

// One normalized movement row per SKU per movement type per captured record — the relational
// shape of the workbook's wide per-SKU columns (report-format-library §3). DFR totals and the
// stock-reconciliation formula (spec §22) are queries over this table, never re-typed numbers.
model SkuMovement {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String          @db.Uuid
  campaignId      String          @db.Uuid
  campaignSkuId   String          @db.Uuid
  campaignSku     CampaignSku     @relation(fields: [campaignSkuId], references: [id], onDelete: Restrict)
  formResponseId  String?         @db.Uuid
  formResponse    FormResponse?   @relation(fields: [formResponseId], references: [id], onDelete: Cascade)
  fieldResponseId String?         @db.Uuid
  fieldResponse   FieldResponse?  @relation(fields: [fieldResponseId], references: [id], onDelete: Cascade)
  locationId      String?         @db.Uuid
  movementType    SkuMovementType
  movementDate    DateTime        @db.Date
  quantity        Decimal         @default(0) @db.Decimal(14, 3)
  amount          Decimal?        @db.Decimal(14, 2)
  createdAt       DateTime        @default(now())

  @@index([clientId])
  @@index([campaignId, movementDate])
  @@index([campaignSkuId, movementType])
  @@index([formResponseId])
  @@map("sku_movements")
}

// Versioned branding theme document (spec §6, doc 07): the app pulls this at bootstrap and
// contains zero client knowledge of its own.
model CampaignBranding {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId             String    @unique @db.Uuid
  campaign               Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clientId               String    @db.Uuid
  version                Int       @default(1)
  themeJson              Json
  logoUrl                String?
  campaignLogoUrl        String?
  homeBannerUrl          String?
  instructionsText       String?
  escalationContactName  String?
  escalationContactPhone String?
  publishedAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([clientId])
  @@map("campaign_branding")
}

// Master activity template library (spec §9.4) — Van campaign, Roadshow, Mela stall, etc.
model ActivityType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  code        String   @unique
  description String?
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaigns          Campaign[]
  activityTemplates  ActivityTemplate[]
  campaignActivities CampaignActivity[]

  @@map("activity_types")
}

model ActivityTemplate {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  activityTypeId    String       @db.Uuid
  activityType      ActivityType @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  name              String
  code              String       @unique
  description       String?
  defaultConfigJson Json
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  campaignActivities CampaignActivity[]

  @@map("activity_templates")
}

// The campaign-scoped *copy* of a template (doc 07: "campaign-level edits never touch the master
// library"). This is what ActivityInstance rows are actual field occurrences of.
model CampaignActivity {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String            @db.Uuid
  campaignId         String            @db.Uuid
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  activityTemplateId String?           @db.Uuid
  activityTemplate   ActivityTemplate? @relation(fields: [activityTemplateId], references: [id], onDelete: SetNull)
  activityTypeId     String            @db.Uuid
  activityType       ActivityType      @relation(fields: [activityTypeId], references: [id], onDelete: Restrict)
  name               String
  configJson         Json
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  activityInstances ActivityInstance[]

  @@index([clientId])
  @@index([campaignId])
  @@map("campaign_activities")
}

// State → Region → District → Tehsil tree (spec §5).
model Geography {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  level     GeographyLevel
  name      String
  code      String?
  parentId  String?        @db.Uuid
  parent    Geography?     @relation("GeographyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Geography[]    @relation("GeographyTree")
  createdAt DateTime       @default(now())

  locations Location[]
  retailers Retailer[]

  @@index([parentId])
  @@map("geographies")
}

model Location {
  id                 String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId           String?                               @db.Uuid
  campaignId         String?                               @db.Uuid
  geographyId        String                                @db.Uuid
  geography          Geography                             @relation(fields: [geographyId], references: [id], onDelete: Restrict)
  name               String
  address            String?
  latitude           Decimal                               @db.Decimal(9, 6)
  longitude          Decimal                               @db.Decimal(9, 6)
  geoPoint           Unsupported("geography(Point,4326)")?
  contactPersonName  String?
  contactPersonPhone String?
  status             LocationStatus                        @default(ACTIVE)
  createdAt          DateTime                              @default(now())
  updatedAt          DateTime                              @updatedAt

  pjpRows           PJPRow[]
  routeLocations    RouteLocation[]
  activityInstances ActivityInstance[]

  @@index([clientId])
  @@index([campaignId])
  @@map("locations")
}

model PJP {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId     String    @db.Uuid
  campaignId   String    @db.Uuid
  campaign     Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  fileName     String
  uploadedById String    @db.Uuid
  status       PjpStatus @default(DRAFT)
  totalRows    Int       @default(0)
  invalidRows  Int       @default(0)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rows PJPRow[]

  @@index([clientId])
  @@index([campaignId])
  @@map("pjps")
}

model PJPRow {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId         String       @db.Uuid
  pjpId            String       @db.Uuid
  pjp              PJP          @relation(fields: [pjpId], references: [id], onDelete: Cascade)
  campaignId       String       @db.Uuid
  date             DateTime
  stateName        String
  districtName     String
  tehsilName       String
  locationName     String
  locationId       String?      @db.Uuid
  location         Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @db.Decimal(9, 6)
  teamId           String?      @db.Uuid
  team             Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  supervisorUserId String?      @db.Uuid
  vehicleInfo      String?
  plannedSequence  Int?
  plannedStartTime DateTime?
  plannedEndTime   DateTime?
  targetJson       Json?
  contactPerson    String?
  remarks          String?
  status           PjpRowStatus @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  userAssignments   UserAssignment[]
  activityInstances ActivityInstance[]

  @@index([clientId])
  @@index([campaignId])
  @@map("pjp_rows")
}

model Route {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId    String   @db.Uuid
  campaignId  String   @db.Uuid
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routeLocations RouteLocation[]

  @@index([clientId])
  @@index([campaignId])
  @@map("routes")
}

model RouteLocation {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  routeId    String   @db.Uuid
  route      Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  locationId String   @db.Uuid
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  sequence   Int
  createdAt  DateTime @default(now())

  @@unique([routeId, sequence])
  @@map("route_locations")
}

model Team {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId       String   @db.Uuid

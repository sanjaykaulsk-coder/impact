# IMPACT FIELD COMMAND — environment variables
# Copy to .env for local development. These are LOCAL DEV DEFAULTS ONLY.
# No production secret ever belongs in this file or in source control.

NODE_ENV=development

# --- PostgreSQL (Docker Compose service: postgres) ---
POSTGRES_USER=impact
POSTGRES_PASSWORD=impact_dev_password_change_me
POSTGRES_DB=impact_field_command
POSTGRES_PORT=5432
DATABASE_URL=postgresql://impact:impact_dev_password_change_me@localhost:5432/impact_field_command?schema=public
# The running API connects with this restricted, non-superuser role (created by the
# rls_and_app_role migration) so Postgres Row-Level Security actually applies to it — the
# DATABASE_URL owner role above is used for migrations only and always bypasses RLS.
APP_DATABASE_URL=postgresql://field_command_app:impact_app_dev_password_change_me@localhost:5432/impact_field_command?schema=public

# --- Redis (Docker Compose service: redis) ---
REDIS_URL=redis://localhost:6379

# --- MinIO / S3-compatible object storage (Docker Compose service: minio) ---
MINIO_ROOT_USER=impact_minio_admin
MINIO_ROOT_PASSWORD=impact_minio_dev_password_change_me
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_BUCKET_MEDIA=field-command-media
MINIO_SIGNED_URL_TTL_SECONDS=900

# --- Backend (NestJS) ---
BACKEND_PORT=4000
API_PREFIX=api/v1

# JWT — generate real random secrets per environment; these are dev placeholders only
JWT_ACCESS_SECRET=dev_access_secret_replace_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=dev_refresh_secret_replace_me
JWT_REFRESH_TTL=30d

# Max concurrently active devices per user (device binding, spec §7)
MAX_ACTIVE_DEVICES_PER_USER=2

# --- OTP provider adapter ---
# OTP_PROVIDER=mock is the only implementation in this phase. It never sends a real SMS;
# it logs the code to the backend console and returns it in the API response body so the
# founder/dev can log in without any SMS gateway. Clearly marked MOCK end to end.
OTP_PROVIDER=mock
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300

# --- WhatsApp / Push adapters (interfaces only in this phase; MOCK) ---
WHATSAPP_PROVIDER=mock
PUSH_PROVIDER=mock

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
